rules_version = '2';

// IndiaAssist AI -- Firestore security rules.
//
// Admin email is already set below (rssindhu48@gmail.com). If you ever change
// the admin account, update it here too, in the admin dashboard's
// VITE_ADMIN_EMAILS, and in the app's SEED_ADMIN_EMAIL.
// To publish: paste this whole file in Firebase Console > Firestore Database >
// Rules > Publish.
//
// What these rules do:
//  - Anyone signed in can READ the service catalog and journeys.
//  - Only the admin email can ADD / EDIT / DELETE services and journeys.
//  - Each user can read and write ONLY their own profile, reminders and
//    document records. Nobody can read anyone else's data.
//  - Signed-in users can submit reports; only the admin can read them.
//  - Everything else is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "rssindhu48@gmail.com";
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /journeys/{journeyId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /profiles/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // Reports from users ("report this answer" / "report incorrect information").
    // Anyone signed in can create ONE report as themselves; only the admin can read them.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ["uid", "type", "reason", "question", "answer", "serviceId", "serviceName", "createdAt"])
        && request.resource.data.type is string
        && request.resource.data.reason is string
        && request.resource.data.createdAt is number
        && request.resource.data.question.size() <= 1000
        && request.resource.data.answer.size() <= 3000;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
