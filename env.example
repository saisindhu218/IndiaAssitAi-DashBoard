# Copy to .env and fill in with the SAME Firebase project values used by
# your indiaassist-ai mobile app (find them in your mobile app's .env,
# just without the EXPO_PUBLIC_ prefix -- Vite uses VITE_ instead).

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Only accounts with an email in this comma-separated list can log into
# the dashboard, even if they have valid Firebase Auth credentials.
VITE_ADMIN_EMAILS=you@example.com

# Address of your Cloudflare Worker (the same one the mobile app uses as
# EXPO_PUBLIC_AI_PROXY_URL). Needed for "Draft with AI" and "Changes".
VITE_AI_PROXY_URL=https://indiaassist-ai-proxy.your-subdomain.workers.dev
